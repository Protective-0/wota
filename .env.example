# ============================================================
# DISCORD MEDIA SCRAPER BOT — KONFIGURASI ENVIRONMENT
# Salin file ini menjadi .env dan isi nilai yang sesuai
# ============================================================

# --- Discord Configuration ---
# [WAJIB] Bot token dari Discord Developer Portal (Applications → Bot → Token → Copy)
DISCORD_BOT_TOKEN=your_bot_token_here

# [OPSIONAL] Channel ID default untuk fallback pengiriman media jika tidak dispesifikasikan saat /add
# Jika dikosongkan, bot otomatis merespons ke channel tempat perintah/link dikirim.
DISCORD_CHANNEL_ID=

# [OPSIONAL] User ID Discord pemilik bot (Superadmin override).
# Jika dikosongkan, bot OTOMATIS mendeteksi akun pemilik bot dari Discord Developer Portal!
# Seluruh Administrator & Manager di setiap server juga otomatis memiliki izin.
DISCORD_ALLOWED_USER_ID=

# --- Path & Direktori ---
# Folder temporer untuk menyimpan media sebelum dikirim
TEMP_DIR=./temp_media

# Folder untuk menyimpan session cookies browser
SESSION_DIR=./sessions

# Path file database SQLite lokal
DB_PATH=./data/bot_data.db

# --- Batas Ukuran File & Kompresi (FFmpeg) ---
# Ukuran maksimal file video sebelum dikompresi (dalam MB)
MAX_FILE_SIZE_MB=10

# Target ukuran setelah kompresi (beri buffer dari MAX_FILE_SIZE_MB)
TARGET_FILE_SIZE_MB=9

# Minimum bitrate video saat kompresi (kbps)
MIN_VIDEO_BITRATE_KBPS=300

# --- Delay & Timing ---
# Random delay antara request scraping (detik)
DOWNLOAD_DELAY_MIN=2
DOWNLOAD_DELAY_MAX=5

# Jeda aman antar pengiriman pesan ke Discord (detik)
SEND_DELAY_SECONDS=3

# --- Playwright Browser ---
# Mode browser: true = headed, false = headless (Wajib false untuk server Docker/Linux)
BROWSER_HEADED=false

# Timeout maksimal menunggu login manual jika diperlukan (detik)
MANUAL_LOGIN_TIMEOUT=300

# Path kustom binary browser (kosongkan jika menggunakan default Chromium Playwright)
BROWSER_EXECUTABLE_PATH=

# --- Concurrency ---
# Jumlah maksimal post yang diproses secara bersamaan
CONCURRENT_DOWNLOADS=3

# --- Session Tokens (Autentikasi Platform) ---
# Salin value cookie dari DevTools browser setelah login ke platform:

# Instagram: salin value cookie "sessionid" dari .instagram.com
INSTAGRAM_SESSION_ID=

# TikTok: salin value cookie "sessionid" dari .tiktok.com
TIKTOK_SESSION_ID=

# Twitter/X: salin DUA cookie dari .x.com
TWITTER_AUTH_TOKEN=
TWITTER_CT0=
