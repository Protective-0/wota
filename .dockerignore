# ============================================================
# Docker Ignore — Discord Media Scraper Bot
# ============================================================

# Environment variables & secrets
.env
.env.*
!.env.example

# Git metadata
.git
.gitignore

# Python virtual environment & cache
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Database files (Mounted via volume in container)
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
bot_data.db
data/*
!data/.gitkeep

# Log files
*.log
logs/

# Sessions & Temporary files (Docker volumes will mount these at runtime)
sessions/*
!sessions/.gitkeep
temp_media/*
!temp_media/.gitkeep
config/cookies/*
!config/cookies/.gitkeep

# IDE settings, documentation & local tools
.vscode/
.idea/
*.swp
*.swo
*~
README.md
.agents/
skills-lock.json
.skills/
scratch/
scratch_*
